from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
app = FastAPI()
books = [
{"id": 1, "title": "Wings of Fire", "author": "Kalam", "available": True},
{"id": 2, "title": "Godan", "author": "Premchand", "available": False},
{"id": 3, "title": "Malgudi Days", "author": "R. K. Narayan", "available":
True},
]
class BookCreate(BaseModel):
title: str
author: str
available: bool = True

@app.get("/books")
def list_books(available: bool | None = None):
if available is None:
return books
return [b for b in books if b["available"] == available]
@app.get("/books/stats")
def book_stats():
open_count = len([b for b in books if b["available"]])
return {"total": len(books), "available": open_count}
@app.get("/books/{book_id}")
def get_book(book_id: int):
for book in books:
if book["id"] == book_id:
return book
raise HTTPException(status_code=404, detail="Book not found")

@app.post("/books", status_code=201)
def create_book(book: BookCreate):
for b in books:
if b["title"].lower() == book.title.lower():
message = "Book already exists"
raise HTTPException(status_code=400, detail=message)
new_book = {"id": len(books) + 1, "title": book.title,
"author": book.author, "available": book.available}
books.append(new_book)
return new_book
