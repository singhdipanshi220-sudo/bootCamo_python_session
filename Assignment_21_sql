CREATE TABLE books (
id INTEGER PRIMARY KEY,
title VARCHAR(100),
author VARCHAR(50)
);
CREATE TABLE members (
id INTEGER PRIMARY KEY,
name VARCHAR(50)
);
CREATE TABLE loans (
member_id INTEGER,
book_id INTEGER
);

